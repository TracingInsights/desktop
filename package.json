{
  "name": "tif1ai-desktop",
  "version": "0.2.2",
  "private": true,
  "description": "TracingInsights desktop app — a main-process inference harness that lets ChatGPT Codex, Grok (SuperGrok), and user-supplied custom providers run through the user's machine instead of the server.",
  "author": {
    "name": "TracingInsights",
    "email": "101667461+TracingInsights@users.noreply.github.com"
  },
  "homepage": "https://github.com/TracingInsights/desktop",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icons": "bun run scripts/generate-icons.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "publish:release": "bun run scripts/publish-release.mjs",
    "test": "bun test",
    "smoke": "bun run scripts/harness-smoke.mjs",
    "e2e": "bun ../tests/scripts/desktop-e2e-cdp.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "png2icons": "^2.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
